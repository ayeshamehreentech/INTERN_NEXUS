# Local: use a private .env or secrets.toml; never commit either.
GROQ_API_KEY = "set-your-own-key"
GROQ_MODEL = "openai/gpt-oss-120b"
PYQUEST_DEPLOYMENT = "local"
PYQUEST_BACKEND_MODE = "local"
PYQUEST_FRONTEND = "original"

# Community Cloud: remove GROQ_API_KEY from the frontend and configure the key
# on the external backend instead. Set these values in Cloud secrets:
# PYQUEST_DEPLOYMENT = "cloud"
# PYQUEST_BACKEND_MODE = "remote"
# PYQUEST_BACKEND_URL = "https://your-learning-backend.example"
# PYQUEST_BACKEND_SECRET = "at-least-32-random-characters-shared-with-backend"
# PYQUEST_REQUIRE_AUTH = "true"
# PYQUEST_IDENTITY_SECRET = "different-at-least-32-random-characters"
# [auth]
# redirect_uri = "https://your-app.streamlit.app/oauth2callback"
# cookie_secret = "another-long-random-secret"
# client_id = "your-oidc-client-id"
# client_secret = "your-oidc-client-secret"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
